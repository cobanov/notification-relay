# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=notifications

# Ports Configuration
# External port for PostgreSQL (access from host: localhost:POSTGRES_EXTERNAL_PORT)
POSTGRES_EXTERNAL_PORT=5432
# External port for API (access from host: localhost:API_PORT)
API_PORT=8000

# API Configuration
API_KEY=your-secret-api-key-change-this
ALLOWED_ORIGINS=*
