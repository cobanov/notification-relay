# Database Configuration
POSTGRES_USER=postgres # Don't forget to change
POSTGRES_PASSWORD=postgres # Don't forget to change
POSTGRES_DB=notifications

# Ports Configuration
# External port for PostgreSQL (access from host: localhost:POSTGRES_EXTERNAL_PORT)
POSTGRES_EXTERNAL_PORT=4142

# External port for API (access from host: localhost:API_PORT)
API_PORT=4141

# API Configuration
API_KEY=your-secret-api-key-change-this # Don't forget to change
ALLOWED_ORIGINS=*
